graph TB

    subgraph "CLIENT LAYER"

        Desktop["Desktop Browser<br/>Chrome/Firefox/Safari"]

        Mobile["Mobile Browser<br/>iOS Safari / Android Chrome"]

        Tablet["Tablet Browser<br/>Responsive UI"]

    end



    subgraph "EDGE LAYER (Optional)"

        CDN["Public HTTPS entry<br/><<optional: Cloudflare, custom domain, WAF>>"]

    end



    subgraph "FRONTEND - Vercel"

        VercelApp["Vite + React + TypeScript<br/><<static SPA + Vercel Edge>>"]

    end



    subgraph "BACKEND - AWS EC2"

        EC2Host["EC2 — Node.js runtime<br/><<Express + HTTP server>>"]



        ExpressApp["Express REST API<br/><<application>>"]



        SocketServer["Socket.IO Server<br/><<realtime notifications>>"]



        CronJobs["Background jobs<br/><<node-cron / scheduler>>"]

    end



    subgraph "DATABASE - Neon"

        NeonPG["Neon PostgreSQL<br/><<serverless Postgres>><br/>ORM: Prisma"]

    end



    subgraph "CACHE - Redis"

        Redis["Redis<br/><<session/cache — e.g. ElastiCache, Upstash>>"]

    end



    subgraph "EXTERNAL SERVICES"

        subgraph "AI & media"

            AIProviders["LLM: Google Gemini<br/>Backup: OpenRouter / Groq<br/>Image: Hugging Face / Replicate<br/><<HTTPS / API keys>>"]

        end



        FileStorage["Cloudinary<br/><<media upload & CDN>>"]



        EmailService["SMTP<br/><<e.g. Gmail / transactional>>"]



        PaymentMock["Payment flow<br/><<in-app mock confirm>>"]

    end



    subgraph "CI/CD"

        GitHub["GitHub<br/><<repository>>"]

    end



    %% Clients → optional edge

    Desktop -->|"HTTPS (443)"| CDN

    Mobile -->|"HTTPS (443)"| CDN

    Tablet -->|"HTTPS (443)"| CDN



    %% Edge → frontend (SPA) and API origin (VITE_API_BASE_URL on EC2)

    CDN -->|"HTTPS<br/>HTML / JS / assets"| VercelApp

    CDN -->|"HTTPS REST + WSS<br/>API + Socket.IO"| EC2Host

    %% EC2 internals

    EC2Host --> ExpressApp

    EC2Host --> SocketServer

    EC2Host --> CronJobs



    ExpressApp -.->|"emit events"| SocketServer

    CronJobs -.->|"scheduled tasks"| ExpressApp



    %% Data layer

    ExpressApp -->|"Prisma Client<br/>SSL (DATABASE_URL)"| NeonPG

    CronJobs -->|"Prisma Client<br/>SSL"| NeonPG

    ExpressApp -->|"redis client<br/>(REDIS_URL)"| Redis

    CronJobs -->|"redis client"| Redis



    %% External APIs

    ExpressApp -->|"HTTPS / REST<br/>API keys"| AIProviders

    ExpressApp -->|"HTTPS / SDK"| FileStorage

    ExpressApp -->|"SMTP (587) TLS"| EmailService

    ExpressApp -->|"in-process<br/>mock gateway"| PaymentMock



    %% CI/CD

    GitHub -->|"Git push<br/>Vercel integration"| VercelApp

    GitHub -.->|"deploy pipeline<br/>SSH / GitHub Actions / AMI"| EC2Host



