@startuml AD-M5-UC5.1-GenerateText
!theme plain
title Activity Diagram - UC5.1: Tạo bài viết từ mô tả, ý tưởng và hình ảnh sản phẩm
caption Tạo nội dung bài viết với Quality Gate, retry/refine và fallback provider

|Người dùng|
|Hệ thống|
|AI Service|

start

|Người dùng|
:Đăng nhập và mở trình soạn bài đăng;
:Nhập mô tả/ý tưởng;
note right: Có thể tải lên hình ảnh sản phẩm
:Nhấn "Tạo bài viết với AI";

|Hệ thống|
:Thu thập mô tả, ý tưởng và hình ảnh (nếu có);

|AI Service|
:Chuẩn hóa đầu vào và prompt;
:Sinh bài viết theo schema (title, body, hashtags);
:Đánh giá chất lượng (evaluate + score);

|Hệ thống|
if (Đạt ngưỡng chất lượng?) then (Có)
  :Hiển thị nội dung trong trình soạn thảo;
  
  |Người dùng|
  if (Hài lòng?) then (Có)
    :Chỉnh sửa nhẹ (nếu cần);
    :Nhấn "Đăng bài";
    
    |Hệ thống|
    :Lưu và xuất bản bài đăng;
  else (Không)
    switch (Hành động?)
    case (Tạo lại)
      :Nhấn "Tạo lại";
      
      |AI Service|
      :Tạo phương án mới;
      
    case (Chỉnh sửa thủ công)
      |Người dùng|
      :Chỉnh sửa nội dung theo ý muốn;
      
    case (Hủy bỏ)
      |Người dùng|
      :Xóa nội dung AI;
      :Viết bài thủ công;
    endswitch
  endif
else (Không)
  if (Còn số lần retry?) then (Có)
    :Refine prompt theo tiêu chí yếu nhất;
    |AI Service|
    :Sinh lại và chấm điểm lại;
  else (Không)
    :Hiển thị lỗi "Nội dung chưa đạt chất lượng,\nvui lòng bổ sung prompt";
    
    |Người dùng|
    :Thử lại hoặc viết thủ công;
  endif
endif

stop

@enduml

