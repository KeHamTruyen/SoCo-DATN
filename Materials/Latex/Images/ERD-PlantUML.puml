Follow ||--o{ User : following
Group ||--o{ GroupInvite : group
Group ||--o{ GroupJoinRequest : group
Group ||--o{ GroupMember : group
GroupInvite ||--o{ User : createdGroupInvites
GroupInvite ||--o{ User : usedGroupInvites
GroupJoinRequest ||--o{ User : reviewedGroupJoinRequests
Group |o--o{ Post : group
Notification ||--o{ User : notifications
Notification ||--o{ User : relatedNotifications
OrderItem |o--o{ Review : orderItem
Order |o--o{ Message : order
Order ||--o{ OrderItem : order
PostComment |o--o{ PostComment : parent
PostComment ||--o{ PostComment : replies
Post ||--o{ PostComment : post
Post ||--o{ PostLike : post
Post ||--o{ PostProductTag : post
Product ||--o{ CartItem : product
Product ||--o{ Category : products
ProductCoView ||--o{ Product : coViewSources
ProductCoView ||--o{ Product : coViewTargets
Product |o--o{ Message : product
Product |o--o{ OrderItem : product
Product ||--o{ PostProductTag : product
Product ||--o{ ProductCoView : sourceProduct
Product ||--o{ ProductCoView : targetProduct
Product ||--o{ ProductImage : product
Product ||--o{ ProductVariant : product
Product ||--o{ ProductView : product
Product |o--o{ ProductView : viewedFromProduct
Product ||--o{ Review : product
Product ||--o{ ScheduledPostProductTag : product
