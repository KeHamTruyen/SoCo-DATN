ADMIN_PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/soco_db
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRE=7d
# CORS: admin SPA origin
ADMIN_CORS_ORIGIN=http://localhost:5174
# Core public URL for uploaded assets (optional)
CORE_PUBLIC_URL=http://localhost:5000
# Required when using seller admin (signed KYC URLs) — same as backend/.env
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email for seller approval (optional) — same as backend
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
