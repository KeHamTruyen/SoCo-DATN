NODE_ENV=development
ADMIN_PORT=5001

# Same Neon/Postgres DB used by main backend
DATABASE_URL=postgresql://user:password@localhost:5432/soco_db

# Required: token signing secret for admin portal
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRE=7d

# Allowed admin frontend origin(s)
ADMIN_CORS_ORIGIN=http://localhost:5174
ADMIN_CORS_ORIGIN_EXTRA=
