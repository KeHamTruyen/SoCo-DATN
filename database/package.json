{
    "name": "soco-database",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate": "prisma generate",
        "db:push": "dotenv -e ../backend/.env -- prisma db push",
        "db:reset": "dotenv -e ../backend/.env -- prisma db push --force-reset --accept-data-loss",
        "migrate": "dotenv -e ../backend/.env -- prisma migrate dev",
        "migrate:deploy": "dotenv -e ../backend/.env -- prisma migrate deploy",
        "migrate:status": "dotenv -e ../backend/.env -- prisma migrate status",
        "studio": "dotenv -e ../backend/.env -- prisma studio",
        "seed": "node prisma/seed.js"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "dependencies": {
        "@prisma/client": "^5.9.1",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.4.1"
    },
    "devDependencies": {
        "dotenv-cli": "^7.4.2",
        "prisma": "5.9.1"
    }
}
