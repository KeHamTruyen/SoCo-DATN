# Database
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/social_commerce?schema=public

# Default avatar URL for new users and seed admin (Cloudinary or CDN)
DEFAULT_USER_AVATAR_URL=

# Prisma seed — required for `npx prisma migrate reset` (single ADMIN user)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULL_NAME=Administrator

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRE=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration
# Sign up at: https://cloudinary.com/users/register_free
# Get credentials from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Email Service (Nodemailer / SMTP) ─────────────────────
# For Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Social Commerce Platform" <noreply@socialcommerce.vn>

# ─── Google Gemini AI (backend; text backup + image: ../backend/.env.example) ─
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Image (HF router + Replicate): AI_IMAGE_PRIMARY / AI_IMAGE_BACKUP in ../backend/.env.example
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_TOKENS=4096
