# SoCo-DATN — single root gitignore (monorepo)

# Dependencies
node_modules/
*/node_modules/

# Environment (keep *.env.example tracked)
.env
.env.*
!.env.example

# Build outputs
dist/
build/
*/dist/
*/build/

# Backend uploads — keep folder structure, ignore uploaded files
backend/src/uploads/avatars/*
backend/src/uploads/posts/*
backend/src/uploads/products/*
!backend/src/uploads/**/.gitkeep

# Frontend — Playwright / Vitest artifacts
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/playwright/.cache/

# Testing / coverage
coverage/
coverage-integration/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local databases
*.sqlite
*.sqlite3
*.db

# Cache / tooling
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo
*.tsbuildinfo

# Code intelligence index (local)
.gitnexus
