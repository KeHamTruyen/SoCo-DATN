# Database
DATABASE_URL=postgresql://username:password@localhost:5432/social_commerce_db?schema=public

# Default avatar URL for new users and seed admin (Cloudinary or CDN)
DEFAULT_USER_AVATAR_URL=

# Prisma seed — required for `npx prisma migrate reset` (one row in `admins`; sign in via POST /api/admin/auth/login)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_ADMIN_FULL_NAME=Administrator

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRE=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./src/uploads

# Cloudinary Configuration
# Sign up at: https://cloudinary.com/users/register_free
# Get credentials from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# AES-256-GCM for seller CCCD / bank account at rest (32 bytes: 64-char hex OR base64-encoded key)
# Required in production. If unset in development, values are stored with a plain: prefix (insecure).
SENSITIVE_DATA_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Email Service (Nodemailer / SMTP) ─────────────────────
# For Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SoCo Platform" <noreply@soco.vn>

# ─── AI Creative Lab — text (Gemini primary + free-tier backup) ─────────────
# Primary: Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_TOKENS=4096
AI_MAX_RETRIES=2
GEMINI_429_MAX_ATTEMPTS=4

# Backup text LLM when Gemini fails (openrouter = free models like :free; groq = free tier)
AI_TEXT_BACKUP_PROVIDER=openrouter
# OpenRouter backup (https://openrouter.ai/) — default model is free-tier
# OPENROUTER_API_KEY=
# OPENROUTER_BACKUP_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_BACKUP_VISION_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=http://localhost:3000

# Groq backup (https://console.groq.com/) — alternative to OpenRouter
# AI_TEXT_BACKUP_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_BACKUP_MODEL=llama-3.3-70b-versatile
# GROQ_BACKUP_VISION_MODEL=llama-3.2-11b-vision-preview

# Optional overrides for backup chat: AI_TEMPERATURE, AI_MAX_TOKENS

# ─── AI Creative Lab — image (HF + Replicate, both support free tiers) ────
# Order: try AI_IMAGE_PRIMARY first, then AI_IMAGE_BACKUP (requires tokens).
# Disable images: AI_IMAGE_PRIMARY=none and AI_IMAGE_BACKUP=none
# Legacy: AI_IMAGE_PROVIDER=huggingface|replicate|none (used if AI_IMAGE_PRIMARY is unset)
AI_IMAGE_PRIMARY=huggingface
AI_IMAGE_BACKUP=replicate
# HF Inference Providers token ("Make calls to Inference Providers"): https://huggingface.co/settings/tokens
# HF_TOKEN=
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Optional base if Hugging Face changes routing (default router hf-inference):
# HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models
# Replicate (https://replicate.com/account/api-tokens)
# REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# REPLICATE_IMAGE_ASPECT_RATIO=1:1
AI_IMAGE_MAX_RETRIES=1

# ─── Admin moderation (separate service) ────────────────────
# See ../admin/README.md — core API no longer exposes /api/admin or admin report/seller routes.
# Admin API uses ADMIN_JWT_SECRET and ADMIN_PORT (default 5001).
