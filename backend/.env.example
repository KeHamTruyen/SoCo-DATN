# Database
DATABASE_URL=postgresql://username:password@localhost:5432/social_commerce_db?schema=public

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# JWT (user + seller + core admin login in main backend)
JWT_SECRET=your-secret-key-here
JWT_EXPIRE=7d

# Main frontend origin for CORS + email links
FRONTEND_URL=http://localhost:3000

# Redis cache
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# Request rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_DISABLED=false
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=25
AUTH_SENSITIVE_RATE_LIMIT_WINDOW_MS=600000
AUTH_SENSITIVE_RATE_LIMIT_MAX=10

# Default avatar URL fallback (optional)
DEFAULT_USER_AVATAR_URL=

# AES-256-GCM key for sensitive seller data (required in production)
SENSITIVE_DATA_KEY=

# Cloudinary (required for upload/media features)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SocialCommerce Platform" <noreply@socialcommerce.vn>

# AI text generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_TOKENS=4096
AI_MAX_RETRIES=2

# Backup text provider: openrouter | groq | none
AI_TEXT_BACKUP_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BACKUP_VISION_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=SoCo-DATN
GROQ_API_KEY=
GROQ_BACKUP_MODEL=llama-3.3-70b-versatile
GROQ_BACKUP_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_BASE_URL=https://api.groq.com/openai/v1

# AI image generation
AI_IMAGE_PRIMARY=huggingface
AI_IMAGE_BACKUP=replicate
AI_IMAGE_PROVIDER=huggingface
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_IMAGE_ASPECT_RATIO=1:1
AI_IMAGE_MAX_RETRIES=1

# Seed defaults
SEED_ADMIN_EMAIL=admin@soco.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_FULL_NAME=Platform Administrator
SEED_QA_USER_PASSWORD=QaUser@123
