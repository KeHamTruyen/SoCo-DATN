{
    "name": "social-commerce-backend",
    "version": "1.0.0",
    "description": "Backend API for Social Commerce Platform",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:ui:run": "vitest run --ui",
        "test:coverage": "vitest run --coverage",
        "test:coverage:integration": "vitest run --config vitest.integration.config.js --coverage",
        "test:integration": "vitest run --config vitest.integration.config.js",
        "test:integration:ui": "vitest --config vitest.integration.config.js --ui",
        "test:all": "npm run test && npm run test:integration",
        "ai:health": "node scripts/check-ai-health.js",
        "prisma:generate": "npm run generate --prefix ../database",
        "prisma:push": "npm run db:push --prefix ../database",
        "prisma:reset": "npm run db:reset --prefix ../database",
        "prisma:migrate": "npm run migrate --prefix ../database",
        "prisma:migrate:deploy": "npm run migrate:deploy --prefix ../database",
        "prisma:migrate:status": "npm run migrate:status --prefix ../database",
        "prisma:studio": "npm run studio --prefix ../database",
        "prisma:seed": "npm run seed --prefix ../database"
    },
    "keywords": [
        "express",
        "postgresql",
        "prisma",
        "social-commerce"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^5.9.1",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^1.41.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "multer-storage-cloudinary": "^4.0.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.1",
        "slugify": "^1.6.6",
        "socket.io": "^4.8.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/supertest": "^7.2.0",
        "@vitest/coverage-v8": "^4.1.4",
        "@vitest/ui": "^4.1.4",
        "nodemon": "^3.0.3",
        "supertest": "^7.2.2",
        "vitest": "^4.1.4",
        "yaml": "^2.8.3"
    }
}
